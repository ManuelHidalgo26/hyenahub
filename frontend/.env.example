# Base de datos (Supabase o Postgres propio)
DATABASE_URL="postgresql://user:password@localhost:5432/hyenahub"

# NextAuth — genera con: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"

# Pusher — server side (nunca exponer al cliente)
PUSHER_APP_ID="2138561"
PUSHER_KEY="your-pusher-key"
PUSHER_SECRET="your-pusher-secret"
PUSHER_CLUSTER="your-pusher-cluster"

# Pusher — client side (se exponen al navegador, solo son públicas)
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="your-pusher-cluster"

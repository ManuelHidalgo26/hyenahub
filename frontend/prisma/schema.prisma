generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRAINER
  CLIENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(CLIENT)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trainer          Trainer?
  client           Client?
  refreshTokens    RefreshToken[]
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Trainer {
  id        String  @id @default(cuid())
  userId    String  @unique
  bio       String?
  specialty String?

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clients       Client[]
  videos        TrainerVideo[]
  diets         Diet[]
  templates     RoutineTemplate[]
  dietTemplates DietTemplate[]

  @@map("trainers")
}

model RoutineTemplate {
  id            String   @id @default(cuid())
  trainerId     String
  name          String
  description   String?
  durationWeeks Int      @default(0)
  createdAt     DateTime @default(now())

  trainer   Trainer                  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  exercises RoutineTemplateExercise[]

  @@index([trainerId])
  @@map("routine_templates")
}

model RoutineTemplateExercise {
  id         String  @id @default(cuid())
  templateId String
  name       String
  sets       Int
  reps       Int
  weight     Float?
  notes      String?
  order      Int     @default(0)

  template RoutineTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("routine_template_exercises")
}

model TrainerVideo {
  id          String   @id @default(cuid())
  trainerId   String
  title       String
  description String?
  videoUrl    String
  exercise    String?
  createdAt   DateTime @default(now())

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([trainerId])
  @@map("trainer_videos")
}

model Client {
  id         String  @id @default(cuid())
  userId     String  @unique
  trainerId  String
  goal       String
  experience String
  equipment  String
  weight     Float?
  age        Int?
  notes      String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer         Trainer          @relation(fields: [trainerId], references: [id])
  routines        Routine[]
  diets           Diet[]
  weeklyFeedbacks WeeklyFeedback[]
  exerciseLogs    ExerciseLog[]

  @@index([trainerId])
  @@map("clients")
}

model Routine {
  id            String   @id @default(cuid())
  clientId      String
  weekStart     DateTime
  durationWeeks Int      @default(0)
  createdAt     DateTime @default(now())
  notes         String?
  hidden        Boolean  @default(false)

  client    Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  days      RoutineDay[]
  exercises Exercise[]
  feedback  WeeklyFeedback?

  @@index([clientId])
  @@map("routines")
}

model RoutineDay {
  id        String @id @default(cuid())
  routineId String
  name      String
  order     Int    @default(0)

  routine   Routine    @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@index([routineId])
  @@map("routine_days")
}

model Exercise {
  id           String  @id @default(cuid())
  routineId    String
  dayId        String?
  name         String
  sets         Int
  reps         Int
  weight       Float?
  notes        String?
  clientNote   String?
  clientWeight Float?
  order        Int     @default(0)

  routine Routine      @relation(fields: [routineId], references: [id], onDelete: Cascade)
  day     RoutineDay?  @relation(fields: [dayId], references: [id], onDelete: SetNull)
  logs    ExerciseLog[]

  @@index([routineId])
  @@index([dayId])
  @@map("exercises")
}

model ExerciseLog {
  id         String   @id @default(cuid())
  exerciseId String
  clientId   String
  weekOf     DateTime
  loggedAt   DateTime @default(now())

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId],   references: [id], onDelete: Cascade)

  @@unique([exerciseId, clientId, weekOf])
  @@index([clientId, weekOf])
  @@map("exercise_logs")
}

model WeeklyFeedback {
  id        String   @id @default(cuid())
  routineId String   @unique
  clientId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("weekly_feedback")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages",     fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

model Diet {
  id          String   @id @default(cuid())
  clientId    String
  trainerId   String
  name        String
  description String?
  calories    Int?
  protein     Int?
  carbs       Int?
  fat         Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  meals   Meal[]
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([trainerId])
  @@map("diets")
}

model Meal {
  id       String  @id @default(cuid())
  dietId   String
  name     String
  time     String?
  foods    String
  calories Int?
  protein  Int?
  carbs    Int?
  fat      Int?
  notes    String?
  order    Int     @default(0)

  diet Diet @relation(fields: [dietId], references: [id], onDelete: Cascade)

  @@index([dietId])
  @@map("meals")
}

model DietTemplate {
  id          String   @id @default(cuid())
  trainerId   String
  name        String
  description String?
  calories    Int?
  protein     Int?
  carbs       Int?
  fat         Int?
  createdAt   DateTime @default(now())

  trainer Trainer          @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  meals   DietTemplateMeal[]

  @@index([trainerId])
  @@map("diet_templates")
}

model DietTemplateMeal {
  id         String  @id @default(cuid())
  templateId String
  name       String
  time       String?
  foods      String
  calories   Int?
  protein    Int?
  carbs      Int?
  fat        Int?
  notes      String?
  order      Int     @default(0)

  template DietTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("diet_template_meals")
}
